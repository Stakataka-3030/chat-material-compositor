{
  "name": "chat-material-compositor",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "聊天素材合成器",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "package:source": "tsx scripts/package-delivery.ts",
    "package:portable": "node scripts/build-portable.mjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.0.2",
    "puppeteer": "25.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "puppeteer@25.13.0": true
  },
  "license": "MPL-2.0"
}
